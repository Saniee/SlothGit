{
  // The webview pages run in a browser inside VS Code: DOM types, no vscode module. The extension host's code is
  // checked by the root tsconfig.json, which leaves the pages out.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["."],
  "exclude": []
}
